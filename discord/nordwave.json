{
  "_info": "Plan för Nordwave Studios. Nya medlemmar ser bara Information tills de reagerat på reglerna och fått Recruit (Carl-bot). Visa ändringar: node cli.js plan nordwave.json",
  "everyone": [
    "CreateInstantInvite", "ChangeNickname", "ReadMessageHistory",
    "SendMessages", "SendMessagesInThreads", "CreatePublicThreads", "EmbedLinks", "AttachFiles",
    "AddReactions", "UseExternalEmojis", "UseExternalStickers", "UseApplicationCommands", "UseExternalApps",
    "SendVoiceMessages", "SendPolls",
    "Connect", "Speak", "Stream", "UseVAD", "RequestToSpeak",
    "UseEmbeddedActivities", "UseSoundboard", "UseExternalSounds", "SetVoiceChannelStatus"
  ],
  "roles": [
    { "name": "Koloss", "color": "#992d22", "hoist": true, "permissions": ["Administrator"] },
    {
      "name": "Moderator", "color": "#3498db", "hoist": true, "mentionable": true,
      "permissions": [
        "ViewChannel", "ManageMessages", "ManageThreads", "KickMembers", "ModerateMembers", "MuteMembers",
        "DeafenMembers", "MoveMembers", "ManageNicknames", "ViewAuditLog", "MentionEveryone", "CreateEvents"
      ]
    },
    { "name": "Member", "color": "#2ecc71", "hoist": true, "permissions": ["ViewChannel", "CreatePrivateThreads", "CreateEvents"] },
    { "name": "Recruit", "color": "#1f8b4c", "hoist": true, "permissions": ["ViewChannel"] }
  ],
  "channels": [
    {
      "name": "Information",
      "type": "category",
      "overwrites": {
        "@everyone": { "allow": ["ViewChannel"], "deny": ["SendMessages", "CreatePublicThreads"] },
        "Moderator": { "allow": ["SendMessages"] }
      },
      "channels": [
        {
          "name": "welcome", "topic": "Welcome to Nordwave Studios!",
          "overwrites": { "@everyone": { "allow": ["ViewChannel"], "deny": ["SendMessages", "CreatePublicThreads"] }, "Moderator": { "allow": ["SendMessages"] } }
        },
        {
          "name": "rules", "topic": "Read the rules before posting.",
          "overwrites": { "@everyone": { "allow": ["ViewChannel"], "deny": ["SendMessages", "CreatePublicThreads"] }, "Moderator": { "allow": ["SendMessages"] } }
        },
        {
          "name": "news", "topic": "Updates from the team.",
          "overwrites": { "@everyone": { "allow": ["ViewChannel"], "deny": ["SendMessages", "CreatePublicThreads"] }, "Moderator": { "allow": ["SendMessages"] } }
        }
      ]
    },
    {
      "name": "Text Channels",
      "type": "category",
      "channels": [
        { "name": "general", "topic": "Talk about anything." },
        { "name": "introductions", "topic": "Tell us who you are." },
        { "name": "off-topic", "slowmode": 5 },
        { "name": "one-more-wave" },
        { "name": "svenska", "topic": "För er som vill snacka svenska." }
      ]
    },
    {
      "name": "Voice Channels",
      "type": "category",
      "channels": [
        { "name": "General", "type": "voice" },
        { "name": "Meeting", "type": "voice", "userLimit": 10 }
      ]
    },
    {
      "name": "Moderation",
      "type": "category",
      "overwrites": {
        "@everyone": { "deny": ["ViewChannel"] },
        "Moderator": { "allow": ["ViewChannel"] }
      },
      "channels": [
        { "name": "mod-chat" },
        {
          "name": "mod-log",
          "overwrites": {
            "@everyone": { "deny": ["ViewChannel"] },
            "Moderator": { "allow": ["ViewChannel"] },
            "carl-bot": { "allow": ["ViewChannel", "SendMessages", "EmbedLinks"] }
          }
        }
      ]
    }
  ]
}
